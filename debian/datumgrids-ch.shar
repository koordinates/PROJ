SHAR_EOF
${echo} xz-decompressing file CHENYX06a.gsb &&

xz -dc ${lock_dir}/xzi > 'CHENYX06a.gsb' && \
  (set 20 09 07 22 11 03 48 'CHENYX06a.gsb'
   eval "${shar_touch}") && \
  chmod 0644 'CHENYX06a.gsb'
if test $? -ne 0
then ${echo} "restore of CHENYX06a.gsb failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'CHENYX06a.gsb': 'MD5 check failed'
       ) << \SHAR_EOF
202c32821a478094f15aad3e658073c8  CHENYX06a.gsb
SHAR_EOF

else
test `LC_ALL=C wc -c < 'CHENYX06a.gsb'` -ne 3310656 && \
  ${echo} "restoration warning:  size of 'CHENYX06a.gsb' is not 3310656"
  fi
fi
# ============= CHENYX06_etrs.asc ==============
if test -n "${keep_file}" && test -f 'CHENYX06_etrs.asc'
then
${echo} "x - SKIPPING CHENYX06_etrs.asc (file already exists)"

else
${echo} "x - extracting CHENYX06_etrs.asc xz-compressed"
