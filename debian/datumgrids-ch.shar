${echo} xz-decompressing file CHENYX06.asc &&

xz -dc ${lock_dir}/xzi > 'CHENYX06.asc' && \
  (set 20 08 06 12 16 18 40 'CHENYX06.asc'
   eval "${shar_touch}") && \
  chmod 0644 'CHENYX06.asc'
if test $? -ne 0
then ${echo} "restore of CHENYX06.asc failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'CHENYX06.asc': 'MD5 check failed'
       ) << \SHAR_EOF
f943412089016baa4fa7b0c05b90841f  CHENYX06.asc
SHAR_EOF

else
test `LC_ALL=C wc -c < 'CHENYX06.asc'` -ne 8689957 && \
  ${echo} "restoration warning:  size of 'CHENYX06.asc' is not 8689957"
  fi
fi
# ============= CHENYX06.gsb ==============
if test -n "${keep_file}" && test -f 'CHENYX06.gsb'
then
${echo} "x - SKIPPING CHENYX06.gsb (file already exists)"

