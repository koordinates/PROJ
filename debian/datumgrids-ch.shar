SHAR_EOF
${echo} xz-decompressing file CHENYX06a.asc &&

xz -dc ${lock_dir}/xzi > 'CHENYX06a.asc' && \
  (set 20 09 07 22 10 55 56 'CHENYX06a.asc'
   eval "${shar_touch}") && \
  chmod 0644 'CHENYX06a.asc'
if test $? -ne 0
then ${echo} "restore of CHENYX06a.asc failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'CHENYX06a.asc': 'MD5 check failed'
       ) << \SHAR_EOF
6c6a9d600d0fbdf59cef40b72fa4ee5d  CHENYX06a.asc
SHAR_EOF

else
test `LC_ALL=C wc -c < 'CHENYX06a.asc'` -ne 8689957 && \
  ${echo} "restoration warning:  size of 'CHENYX06a.asc' is not 8689957"
  fi
fi
# ============= CHENYX06a.gsb ==============
if test -n "${keep_file}" && test -f 'CHENYX06a.gsb'
then
${echo} "x - SKIPPING CHENYX06a.gsb (file already exists)"

else
${echo} "x - extracting CHENYX06a.gsb xz-compressed"
