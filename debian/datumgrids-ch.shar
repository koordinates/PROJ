SHAR_EOF
${echo} xz-decompressing file CHENYX06_etrs.gsb &&

xz -dc ${lock_dir}/xzi > 'CHENYX06_etrs.gsb' && \
  (set 20 12 02 14 15 04 02 'CHENYX06_etrs.gsb'
   eval "${shar_touch}") && \
  chmod 0644 'CHENYX06_etrs.gsb'
if test $? -ne 0
then ${echo} "restore of CHENYX06_etrs.gsb failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'CHENYX06_etrs.gsb': 'MD5 check failed'
       ) << \SHAR_EOF
bd1ab1cb350caebf0361bb9d7c7f1790  CHENYX06_etrs.gsb
SHAR_EOF

else
test `LC_ALL=C wc -c < 'CHENYX06_etrs.gsb'` -ne 3310656 && \
  ${echo} "restoration warning:  size of 'CHENYX06_etrs.gsb' is not 3310656"
  fi
fi
if rm -fr ${lock_dir}
then ${echo} "x - removed lock directory ${lock_dir}."
else ${echo} "x - failed to remove lock directory ${lock_dir}."
     exit 1
fi
exit 0
