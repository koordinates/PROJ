SHAR_EOF
${echo} xz-decompressing file CHENYX06_etrs.asc &&

xz -dc ${lock_dir}/xzi > 'CHENYX06_etrs.asc' && \
  (set 20 12 02 14 16 19 02 'CHENYX06_etrs.asc'
   eval "${shar_touch}") && \
  chmod 0644 'CHENYX06_etrs.asc'
if test $? -ne 0
then ${echo} "restore of CHENYX06_etrs.asc failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'CHENYX06_etrs.asc': 'MD5 check failed'
       ) << \SHAR_EOF
4f414a80f566f1ee20973ca805b68bdd  CHENYX06_etrs.asc
SHAR_EOF

else
test `LC_ALL=C wc -c < 'CHENYX06_etrs.asc'` -ne 8689957 && \
  ${echo} "restoration warning:  size of 'CHENYX06_etrs.asc' is not 8689957"
  fi
fi
# ============= CHENYX06_etrs.gsb ==============
if test -n "${keep_file}" && test -f 'CHENYX06_etrs.gsb'
then
${echo} "x - SKIPPING CHENYX06_etrs.gsb (file already exists)"

else
${echo} "x - extracting CHENYX06_etrs.gsb xz-compressed"
