SHAR_EOF
${echo} xz-decompressing file TN &&

xz -dc ${lock_dir}/xzi > 'TN' && \
  (set 20 18 09 15 15 56 14 'TN'
   eval "${shar_touch}") && \
  chmod 0644 'TN'
if test $? -ne 0
then ${echo} "restore of TN failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'TN': 'MD5 check failed'
       ) << \SHAR_EOF
9407870d1bf9e703e639735a80090c9f  TN
SHAR_EOF

else
test `LC_ALL=C wc -c < 'TN'` -ne 4424 && \
  ${echo} "restoration warning:  size of 'TN' is not 4424"
  fi
fi
# ============= WI ==============
if test -n "${keep_file}" && test -f 'WI'
then
${echo} "x - SKIPPING WI (file already exists)"

else
${echo} "x - extracting WI xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
