SHAR_EOF
${echo} xz-decompressing file ntf_r93.gsb &&

xz -dc ${lock_dir}/xzi > 'ntf_r93.gsb' && \
  (set 20 18 02 21 19 28 24 'ntf_r93.gsb'
   eval "${shar_touch}") && \
  chmod 0644 'ntf_r93.gsb'
if test $? -ne 0
then ${echo} "restore of ntf_r93.gsb failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'ntf_r93.gsb': 'MD5 check failed'
       ) << \SHAR_EOF
3a280f559b97ed84124f53a2ec7b6c0f  ntf_r93.gsb
SHAR_EOF

else
test `LC_ALL=C wc -c < 'ntf_r93.gsb'` -ne 277424 && \
  ${echo} "restoration warning:  size of 'ntf_r93.gsb' is not 277424"
  fi
fi
# ============= ntv1_can.dat ==============
if test -n "${keep_file}" && test -f 'ntv1_can.dat'
then
${echo} "x - SKIPPING ntv1_can.dat (file already exists)"

else
${echo} "x - extracting ntv1_can.dat xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
