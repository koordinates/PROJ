SHAR_EOF
${echo} xz-decompressing file conus &&

xz -dc ${lock_dir}/xzi > 'conus' && \
  (set 20 18 09 15 15 56 14 'conus'
   eval "${shar_touch}") && \
  chmod 0644 'conus'
if test $? -ne 0
then ${echo} "restore of conus failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'conus': 'MD5 check failed'
       ) << \SHAR_EOF
b3ddb364b185403eae8273d5066329e3  conus
SHAR_EOF

else
test `LC_ALL=C wc -c < 'conus'` -ne 264424 && \
  ${echo} "restoration warning:  size of 'conus' is not 264424"
  fi
fi
# ============= egm96_15.gtx ==============
if test -n "${keep_file}" && test -f 'egm96_15.gtx'
then
${echo} "x - SKIPPING egm96_15.gtx (file already exists)"

else
${echo} "x - extracting egm96_15.gtx xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
