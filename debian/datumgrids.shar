SHAR_EOF
${echo} xz-decompressing file stpaul &&

xz -dc ${lock_dir}/xzi > 'stpaul' && \
  (set 20 18 09 15 15 56 14 'stpaul'
   eval "${shar_touch}") && \
  chmod 0644 'stpaul'
if test $? -ne 0
then ${echo} "restore of stpaul failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'stpaul': 'MD5 check failed'
       ) << \SHAR_EOF
40c3d4da257fe1156e5e6a1f6e9ec59b  stpaul
SHAR_EOF

else
test `LC_ALL=C wc -c < 'stpaul'` -ne 7048 && \
  ${echo} "restoration warning:  size of 'stpaul' is not 7048"
  fi
fi
# ============= TN ==============
if test -n "${keep_file}" && test -f 'TN'
then
${echo} "x - SKIPPING TN (file already exists)"

else
${echo} "x - extracting TN xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
