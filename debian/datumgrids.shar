SHAR_EOF
${echo} xz-decompressing file egm96_15.gtx &&

xz -dc ${lock_dir}/xzi > 'egm96_15.gtx' && \
  (set 20 18 02 26 19 39 48 'egm96_15.gtx'
   eval "${shar_touch}") && \
  chmod 0644 'egm96_15.gtx'
if test $? -ne 0
then ${echo} "restore of egm96_15.gtx failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'egm96_15.gtx': 'MD5 check failed'
       ) << \SHAR_EOF
62428e0b45b9b38631c08bd208aee641  egm96_15.gtx
SHAR_EOF

else
test `LC_ALL=C wc -c < 'egm96_15.gtx'` -ne 4153000 && \
  ${echo} "restoration warning:  size of 'egm96_15.gtx' is not 4153000"
  fi
fi
# ============= FL ==============
if test -n "${keep_file}" && test -f 'FL'
then
${echo} "x - SKIPPING FL (file already exists)"

else
${echo} "x - extracting FL xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
