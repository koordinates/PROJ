SHAR_EOF
${echo} xz-decompressing file stgeorge &&

xz -dc ${lock_dir}/xzi > 'stgeorge' && \
  (set 20 18 09 15 15 56 14 'stgeorge'
   eval "${shar_touch}") && \
  chmod 0644 'stgeorge'
if test $? -ne 0
then ${echo} "restore of stgeorge failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'stgeorge': 'MD5 check failed'
       ) << \SHAR_EOF
d8632bdf751684a72579085b31ed3fe7  stgeorge
SHAR_EOF

else
test `LC_ALL=C wc -c < 'stgeorge'` -ne 59208 && \
  ${echo} "restoration warning:  size of 'stgeorge' is not 59208"
  fi
fi
# ============= stlrnc ==============
if test -n "${keep_file}" && test -f 'stlrnc'
then
${echo} "x - SKIPPING stlrnc (file already exists)"

else
${echo} "x - extracting stlrnc xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
