end
SHAR_EOF
${echo} xz-decompressing file WI &&

xz -dc ${lock_dir}/xzi > 'WI' && \
  (set 20 18 09 15 15 56 14 'WI'
   eval "${shar_touch}") && \
  chmod 0644 'WI'
if test $? -ne 0
then ${echo} "restore of WI failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'WI': 'MD5 check failed'
       ) << \SHAR_EOF
4093b9bb8a85a3ada0aa58ee883bb1b6  WI
SHAR_EOF

else
test `LC_ALL=C wc -c < 'WI'` -ne 6760 && \
  ${echo} "restoration warning:  size of 'WI' is not 6760"
  fi
fi
# ============= WO ==============
if test -n "${keep_file}" && test -f 'WO'
then
${echo} "x - SKIPPING WO (file already exists)"

else
${echo} "x - extracting WO xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
