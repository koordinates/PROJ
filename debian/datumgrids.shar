SHAR_EOF
${echo} xz-decompressing file prvi &&

xz -dc ${lock_dir}/xzi > 'prvi' && \
  (set 20 18 09 15 15 56 14 'prvi'
   eval "${shar_touch}") && \
  chmod 0644 'prvi'
if test $? -ne 0
then ${echo} "restore of prvi failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'prvi': 'MD5 check failed'
       ) << \SHAR_EOF
ea8f9c68069666e7c3d8bac053508fef  prvi
SHAR_EOF

else
test `LC_ALL=C wc -c < 'prvi'` -ne 26728 && \
  ${echo} "restoration warning:  size of 'prvi' is not 26728"
  fi
fi
# ============= README.DATUMGRID ==============
if test -n "${keep_file}" && test -f 'README.DATUMGRID'
then
${echo} "x - SKIPPING README.DATUMGRID (file already exists)"

else
${echo} "x - extracting README.DATUMGRID xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
