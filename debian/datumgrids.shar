SHAR_EOF
${echo} xz-decompressing file BETA2007.gsb &&

xz -dc ${lock_dir}/xzi > 'BETA2007.gsb' && \
  (set 20 18 02 21 19 28 23 'BETA2007.gsb'
   eval "${shar_touch}") && \
  chmod 0644 'BETA2007.gsb'
if test $? -ne 0
then ${echo} "restore of BETA2007.gsb failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'BETA2007.gsb': 'MD5 check failed'
       ) << \SHAR_EOF
9de9eb5f190c645273dc4d7b21294294  BETA2007.gsb
SHAR_EOF

else
test `LC_ALL=C wc -c < 'BETA2007.gsb'` -ne 83696 && \
  ${echo} "restoration warning:  size of 'BETA2007.gsb' is not 83696"
  fi
fi
# ============= conus ==============
if test -n "${keep_file}" && test -f 'conus'
then
${echo} "x - SKIPPING conus (file already exists)"

else
${echo} "x - extracting conus xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
