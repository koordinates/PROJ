SHAR_EOF
${echo} xz-decompressing file stlrnc &&

xz -dc ${lock_dir}/xzi > 'stlrnc' && \
  (set 20 18 09 15 15 56 14 'stlrnc'
   eval "${shar_touch}") && \
  chmod 0644 'stlrnc'
if test $? -ne 0
then ${echo} "restore of stlrnc failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'stlrnc': 'MD5 check failed'
       ) << \SHAR_EOF
cc3f866cd8579f9311221dbffc63b977  stlrnc
SHAR_EOF

else
test `LC_ALL=C wc -c < 'stlrnc'` -ne 26728 && \
  ${echo} "restoration warning:  size of 'stlrnc' is not 26728"
  fi
fi
# ============= stpaul ==============
if test -n "${keep_file}" && test -f 'stpaul'
then
${echo} "x - SKIPPING stpaul (file already exists)"

else
${echo} "x - extracting stpaul xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
begin 600 _sh04446/xzi
