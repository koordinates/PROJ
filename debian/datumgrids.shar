SHAR_EOF
${echo} xz-decompressing file alaska &&

xz -dc ${lock_dir}/xzi > 'alaska' && \
  (set 20 18 09 15 15 56 14 'alaska'
   eval "${shar_touch}") && \
  chmod 0644 'alaska'
if test $? -ne 0
then ${echo} "restore of alaska failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'alaska': 'MD5 check failed'
       ) << \SHAR_EOF
5bb3bfcff4557c8f58c714770fb11e53  alaska
SHAR_EOF

else
test `LC_ALL=C wc -c < 'alaska'` -ne 1053928 && \
  ${echo} "restoration warning:  size of 'alaska' is not 1053928"
  fi
fi
# ============= BETA2007.gsb ==============
if test -n "${keep_file}" && test -f 'BETA2007.gsb'
then
${echo} "x - SKIPPING BETA2007.gsb (file already exists)"

else
${echo} "x - extracting BETA2007.gsb xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
