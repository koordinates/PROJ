`
end
SHAR_EOF
${echo} xz-decompressing file WO &&

xz -dc ${lock_dir}/xzi > 'WO' && \
  (set 20 18 09 15 15 56 14 'WO'
   eval "${shar_touch}") && \
  chmod 0644 'WO'
if test $? -ne 0
then ${echo} "restore of WO failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'WO': 'MD5 check failed'
       ) << \SHAR_EOF
6b28a2c11f1c22700ad3fb4434cb8ffe  WO
SHAR_EOF

else
test `LC_ALL=C wc -c < 'WO'` -ne 11112 && \
  ${echo} "restoration warning:  size of 'WO' is not 11112"
  fi
fi
if rm -fr ${lock_dir}
then ${echo} "x - removed lock directory ${lock_dir}."
else ${echo} "x - failed to remove lock directory ${lock_dir}."
     exit 1
fi
exit 0
