SHAR_EOF
${echo} xz-decompressing file nzgd2kgrid0005.gsb &&

xz -dc ${lock_dir}/xzi > 'nzgd2kgrid0005.gsb' && \
  (set 20 18 02 21 19 28 24 'nzgd2kgrid0005.gsb'
   eval "${shar_touch}") && \
  chmod 0644 'nzgd2kgrid0005.gsb'
if test $? -ne 0
then ${echo} "restore of nzgd2kgrid0005.gsb failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'nzgd2kgrid0005.gsb': 'MD5 check failed'
       ) << \SHAR_EOF
871b2ed980e30f63aea7fc7468934db2  nzgd2kgrid0005.gsb
SHAR_EOF

else
test `LC_ALL=C wc -c < 'nzgd2kgrid0005.gsb'` -ne 318464 && \
  ${echo} "restoration warning:  size of 'nzgd2kgrid0005.gsb' is not 318464"
  fi
fi
