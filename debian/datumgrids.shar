end
SHAR_EOF
${echo} xz-decompressing file FL &&

xz -dc ${lock_dir}/xzi > 'FL' && \
  (set 20 18 09 15 15 56 14 'FL'
   eval "${shar_touch}") && \
  chmod 0644 'FL'
if test $? -ne 0
then ${echo} "restore of FL failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'FL': 'MD5 check failed'
       ) << \SHAR_EOF
e841cc2cee97c6f95320d8d402f8800f  FL
SHAR_EOF

else
test `LC_ALL=C wc -c < 'FL'` -ne 8872 && \
  ${echo} "restoration warning:  size of 'FL' is not 8872"
  fi
fi
# ============= hawaii ==============
if test -n "${keep_file}" && test -f 'hawaii'
then
${echo} "x - SKIPPING hawaii (file already exists)"

else
${echo} "x - extracting hawaii xz-compressed"
  sed 's/^X//' << 'SHAR_EOF' | uudecode &&
